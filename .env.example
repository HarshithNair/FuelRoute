DEBUG=true
# Required for deployment when DEBUG=false. Generate a long random value.
SECRET_KEY=development-only-fuelroute-key-do-not-deploy
ALLOWED_HOSTS=localhost,127.0.0.1
OSRM_URL=https://router.project-osrm.org
GEOCODER_URL=https://nominatim.openstreetmap.org
# Set an identifying application name and contact for a hosted deployment.
GEOCODER_USER_AGENT=FuelRouteAssessment/1.0 (local evaluation)
HTTP_TIMEOUT=25
CORRIDOR_MILES=2
DETOUR_FACTOR=1.5
MAX_CANDIDATES=300
SOLVER_SECONDS=15
SECURE_SSL_REDIRECT=false
